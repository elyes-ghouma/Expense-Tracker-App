{
  "expo": {
    "name": "Pocketwise",
    "slug": "pocketwise-expense-tracker",
    "scheme": "pocketwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      ["expo-sqlite", { "enableFTS": true }],
      "expo-localization",
      "expo-notifications"
    ],
    "experiments": { "typedRoutes": true },
    "ios": { "supportsTablet": true },
    "android": { "adaptiveIcon": { "backgroundColor": "#5B5FEF" } }
  }
}
